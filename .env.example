# ---- Daily task pages -------------------------------------------------
# Off unless this is exactly "true".
DAILY_TASK_ENABLED=true

# Where the pages go, and who owns them. Both are UUIDs from your database:
#   select id, name from spaces;
#   select id, email from users;
DAILY_TASK_SPACE_ID=
DAILY_TASK_USER_ID=

# Optional: nest every daily page under one parent page.
DAILY_TASK_PARENT_PAGE_ID=

# Mon-Fri at 06:00. The weekend is skipped by the schedule and checked again
# in code, so a hand-run on a Saturday still does nothing.
# Page title. Takes {date} {dd/mm/yyyy} {weekday} and friends.
# Keep this identical to the space's default template title.
DAILY_TASK_TITLE={date}

DAILY_TASK_CRON=0 6 * * 1-5
DAILY_TASK_TIMEZONE=Asia/Ho_Chi_Minh

# Optional: emoji shown on the page.
DAILY_TASK_ICON=

# Heading names. Change these and the carry-over follows, but rename them on
# a running instance and yesterday's page stops being readable to it.
DAILY_TASK_SECTION_TODAY=Task hôm nay
DAILY_TASK_SECTION_TOMORROW=Dự kiến hôm sau
DAILY_TASK_SECTION_NOTES=Ghi chú

# Optional fixed lines added to every day, separated by "|".
DAILY_TASK_STANDING_ITEMS=
